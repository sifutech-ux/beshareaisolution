# Extend either the verified Telegram account image or the first Facebook Ads release.
ARG ACCOUNT_BASE_IMAGE
FROM ${ACCOUNT_BASE_IMAGE}
RUN if test -e /app/marketing_facebook_ads.py; then \
      echo '0211f9dae7f772869a7ae81dfcd0a2f60bf201c32e3acb28a45709e3a89f06ae  /app/marketing_social.py' | sha256sum -c - && \
      echo '31cbffbd85557bc2f1419955dde918e2c0373b6919444d9a827f0df01b927acd  /app/marketing_lifecycle.py' | sha256sum -c - && \
      echo 'cbc0bfa5576e13dfed7517a998551d91fb937e0824a96cbf68749ecf1eb54776  /app/marketing_facebook_ads.py' | sha256sum -c - && \
      echo 'd8c5d735c04a55725f926754e400395fe221feaa7df2c3a016d8ee6a7cd35f48  /app/pelanggan_marketing.py' | sha256sum -c -; \
    else \
      echo '012232e21b5255e11a5377a024f3eb4ec7db5c1535e972fae9865f3cc3835aeb  /app/marketing_social.py' | sha256sum -c - && \
      echo '859962c0ae3aae23d9146bfce342d79208ca14b1fd3b081346fe73fd9a10e752  /app/marketing_lifecycle.py' | sha256sum -c - && \
      echo '2136446dd6a110e22f5f63602173421d5474fba6eac1b91123ec7e9ca17149de  /app/pelanggan_marketing.py' | sha256sum -c -; \
    fi
COPY copilot/account/marketing_facebook_ads.py copilot/account/marketing_post_ads.py copilot/account/marketing_social.py \
     copilot/account/marketing_lifecycle.py copilot/account/pelanggan_marketing.py /app/
RUN python -B -c 'import marketing_post_ads, marketing_facebook_ads, marketing_lifecycle, pelanggan_marketing, marketing_social'
