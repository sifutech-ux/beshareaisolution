# Extend the account image that already contains the Marketing and Telegram routes.
ARG ACCOUNT_BASE_IMAGE
FROM ${ACCOUNT_BASE_IMAGE}
RUN echo '012232e21b5255e11a5377a024f3eb4ec7db5c1535e972fae9865f3cc3835aeb  /app/marketing_social.py' | sha256sum -c - \
 && echo '859962c0ae3aae23d9146bfce342d79208ca14b1fd3b081346fe73fd9a10e752  /app/marketing_lifecycle.py' | sha256sum -c - \
 && echo '2136446dd6a110e22f5f63602173421d5474fba6eac1b91123ec7e9ca17149de  /app/pelanggan_marketing.py' | sha256sum -c -
COPY copilot/account/marketing_facebook_ads.py copilot/account/marketing_social.py \
     copilot/account/marketing_lifecycle.py copilot/account/pelanggan_marketing.py /app/
RUN python -B -c 'import marketing_facebook_ads, marketing_lifecycle, pelanggan_marketing, marketing_social'
